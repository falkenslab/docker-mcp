{
  "name": "@falkenslab/mcp-server-template",
  "version": "0.0.0",
  "private": true,
  "description": "A Falken's Lab MCP server.",
  "license": "MIT",
  "author": "Falken's Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkenslab/mcp-server-template.git"
  },
  "homepage": "https://falkenslab.github.io/mcp-server-template/",
  "bugs": {
    "url": "https://github.com/falkenslab/mcp-server-template/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-kit"
  ],
  "type": "module",
  "bin": {
    "mcp-server-template": "dist/server.mjs"
  },
  "files": [
    "dist/server.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check-tools.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.5"
  }
}
